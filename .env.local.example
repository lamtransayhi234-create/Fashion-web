# Supabase — copy file này thành `.env.local` và điền giá trị thật.
# Lấy từ Supabase Dashboard → Settings → API Keys

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_YOUR_KEY

# Service role — CHỈ dùng cho seed script local. KHÔNG bao giờ commit giá trị thật.
# KHÔNG add biến này vào Vercel.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_YOUR_KEY
